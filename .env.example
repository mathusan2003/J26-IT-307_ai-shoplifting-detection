# Copy this file to .env for local development.
# Do not commit .env. Do not put passwords, API keys, or tokens in this template.

# Local video path or camera index used during development.
VIDEO_SOURCE=data/samples/example.mp4

# Local paths. Large model files stay on disk and are not committed.
OBJECT_DETECTION_MODEL_PATH=member1-object-detection/models/
TRACKING_CONFIG_PATH=member2-person-tracking/configs/
BEHAVIOUR_CONFIG_PATH=member3-behaviour-analysis/configs/
RISK_MODEL_PATH=member4-risk-prediction/models/

LOG_LEVEL=INFO
